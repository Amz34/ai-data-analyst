# ---- Database -------------------------------------------------------------
# Default points at a local Postgres. Tests use in-memory SQLite automatically.
DS_DB_URL=postgresql+psycopg2://dsapp:change-me@127.0.0.1:5433/dsapp

# ---- Auth -----------------------------------------------------------------
# Generate one: python -c "import secrets;print(secrets.token_urlsafe(48))"
DS_JWT_SECRET=change-me-to-a-long-random-string
DS_JWT_EXPIRES_MIN=4320
DS_ADMIN_TOKEN=
DS_DEFAULT_PLAN=free

# ---- Storage / limits -----------------------------------------------------
DS_DATA_DIR=./data
DS_MAX_UPLOAD_MB=25
DS_SANDBOX_TIMEOUT_S=15
LOG_DIR=./logs

# ---- Model access ---------------------------------------------------------
# Leave the keys blank to run in local-only mode: ingestion, EDA and dashboards
# still work; only the /ask (natural-language) endpoint returns "no model".
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_PRIMARY_RETRIES=2
# Fallback model + simple circuit breaker
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_CIRCUIT_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_S=120
